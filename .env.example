# Vici-Users / EHECTO
# Topología:
#   vici97  = aplicación/orquestador Vici-Users
#   vici222 = DataBase Only (172.20.20.198)
#
# Las credenciales pueden seguir leyéndose de /etc/astguiclient.conf de vici97.
# Nunca subir contraseñas reales al repositorio.

ASTGUI_CONF=/etc/astguiclient.conf
VICI_DB_HOST=172.20.20.198
VICI_DB_EXPECTED_HOST=172.20.20.198

# Overrides opcionales si fueran necesarios:
# VICI_DB_PORT=3306
# VICI_DB_NAME=asterisk
# VICI_DB_USER=cron
# VICI_DB_PASS=change_me

# CP1 = solo lectura/preview. Mantener false hasta validar consultas en producción.
VICI_USERS_ENABLE_CREATE=false
VICI_USERS_USERNAME_MAX_LENGTH=20
