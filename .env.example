# Vici-Users / EHECTO
# Topología:
#   GitHub Pages = frontend estático
#   vici97       = aplicación/orquestador Vici-Users
#   vici222      = DataBase Only (172.20.20.198)
#
# Las credenciales pueden seguir leyéndose de /etc/astguiclient.conf de vici97.
# Nunca subir contraseñas reales al repositorio ni al frontend.

ASTGUI_CONF=/etc/astguiclient.conf
VICI_DB_HOST=172.20.20.198
VICI_DB_EXPECTED_HOST=172.20.20.198
VICI_USERS_CORS_ORIGINS=https://teamdirecto.github.io

# Overrides opcionales si fueran necesarios:
# VICI_DB_PORT=3306
# VICI_DB_NAME=asterisk
# VICI_DB_USER=cron
# VICI_DB_PASS=change_me

# CP1 = solo lectura/preview. Mantener false hasta validar consultas en producción.
VICI_USERS_ENABLE_CREATE=false
VICI_USERS_WRITE_EXECUTOR_ENABLED=false
VICI_USERS_WRITE_EXECUTOR_LOCAL_ONLY=true
VICI_USERS_WRITE_TOKEN_FILE=/etc/vici-users/write_token
VICI_USERS_OPERATORS_FILE=/etc/vici-users/operators.json
VICI_USERS_AUTH_SESSION_TTL=1800
VICI_USERS_PORTAL_WRITE_ENABLED=false
VICI_USERS_USERNAME_MAX_LENGTH=20

# Sincronización post-provisioning con Asterisk.
VICI_USERS_ASTERISK_SYNC_ENABLED=false
VICI_USERS_ASTERISK_SYNC_TIMEOUT=180
# Espera después de rebuild_conf_files=N antes de encolar "sip reload".
VICI_USERS_ASTERISK_SETTLE_SECONDS=10
