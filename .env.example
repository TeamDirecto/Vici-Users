# Vici-Users / EHECTO
# En vici97 normalmente no necesitas definir VICI_DB_* si /etc/astguiclient.conf
# ya contiene las credenciales correctas de la DB VICIdial.

ASTGUI_CONF=/etc/astguiclient.conf

# Overrides opcionales:
# VICI_DB_HOST=127.0.0.1
# VICI_DB_PORT=3306
# VICI_DB_NAME=asterisk
# VICI_DB_USER=cron
# VICI_DB_PASS=change_me

# CP1 = solo lectura/preview. Mantener false hasta validar en vici97.
VICI_USERS_ENABLE_CREATE=false
VICI_USERS_USERNAME_MAX_LENGTH=20
