[Unit]
Description=Vici-Users API - EHECTO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vici-users
EnvironmentFile=-/etc/sysconfig/vici-users
ExecStart=/opt/vici-users/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8094
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
